# Path to the llama-swap configuration swapboard reads models from.
SWAPBOARD_LLAMA_SWAP_CONFIG_PATH=./llama-swap.example.yml
# Port llama-swap serves its OpenAI-compatible API on.
SWAPBOARD_LLAMA_SWAP_PORT=8772
# Optional public OpenAI-compatible Base URL displayed to users.
SWAPBOARD_PUBLIC_ENDPOINT_URL=
# Directory GGUF models are downloaded into.
SWAPBOARD_MODELS_PATH=./data/models
# Optional Hugging Face token, required for private or gated repositories.
SWAPBOARD_HF_TOKEN=

# Web UI: where it reaches the API, and what it binds to.
SWAPBOARD_UI_API_URL=http://127.0.0.1:8771
SWAPBOARD_UI_HOST=127.0.0.1
SWAPBOARD_UI_PORT=8773
